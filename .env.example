# Copie para .env e preencha. NUNCA faça commit do .env.

# Fonte de dados: "fake" (fictícios) até haver autorização da diretoria.
EJOTA_DATA_SOURCE=fake

# Login do diretor
EJOTA_USERNAME=diretor
# Gere com: python -m ejota.cli hash-password   (no Docker: docker compose run --rm ejota python -m ejota.cli hash-password)
# Coloque o hash entre aspas SIMPLES (ele contém "$"): EJOTA_PASSWORD_HASH='$argon2id$v=19$...'
EJOTA_PASSWORD_HASH=
# Gere com: python -m ejota.cli secret-key
EJOTA_SECRET_KEY=
# Em desenvolvimento local sem HTTPS, use false. Em produção (HTTPS), true.
EJOTA_COOKIE_SECURE=false

# Análise de causa: "heuristica" (sem IA) ou "claude" (precisa de ANTHROPIC_API_KEY)
EJOTA_ANALYZER=heuristica
EJOTA_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Data de referência fixa (opcional, AAAA-MM-DD). Vazio = hoje.
EJOTA_REFERENCE_DATE=

# Fontes reais (Etapa 7 em diante; deixe vazio por enquanto)
EJOTA_CLICKUP_TOKEN=
EJOTA_CLICKUP_TEAM_ID=
EJOTA_CLICKUP_SPACE_NAME=Projetos
EJOTA_GOOGLE_CREDENTIALS_FILE=
EJOTA_GOOGLE_SHARED_DRIVE_ID=

EJOTA_LOG_LEVEL=INFO
