{
  "name": "Rede neural da Ejota",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev,ia]'",
  "postStartCommand": "bash scripts/iniciar.sh",
  "postAttachCommand": "bash scripts/acesso.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Rede neural da Ejota", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
